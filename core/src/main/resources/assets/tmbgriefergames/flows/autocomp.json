{
  "name": "AutoComp",
  "hotkey": [],
  "nodes": [
    { "id": "start", "type": "start", "x": 0, "y": 0, "params": {} },
    { "id": "open", "type": "command", "x": 160, "y": 0, "params": { "command": "/rezepte" } },
    { "id": "waitMain", "type": "wait_for_menu", "x": 320, "y": 0, "params": { "title": "=Custom-Kategorien", "timeout": "100" } },
    { "id": "openComp", "type": "click_slot", "x": 480, "y": 0, "params": { "slot": "11", "shift": "true" } },
    { "id": "waitRecipes", "type": "wait_for_menu", "x": 640, "y": 0, "params": { "title": "=Item-Komprimierung-Bauanleitung", "timeout": "100" } },
    { "id": "chooseItem", "type": "click_slot", "x": 800, "y": 0, "params": { "slot": "81", "shift": "true" } },
    { "id": "waitComp", "type": "wait_for_menu", "x": 960, "y": 0, "params": { "title": "=Item-Komprimierung", "timeout": "100" } },
    { "id": "firstLevel", "type": "set_variable", "x": 960, "y": 90, "params": { "name": "level", "value": "1" } },
    { "id": "stillOpen", "type": "if_menu", "x": 160, "y": 180, "params": { "title": "=Item-Komprimierung" } },
    { "id": "gotoLevel", "type": "navigate_page", "x": 320, "y": 180, "params": { "indicator": "49", "prefix": "Komprimierungsstufe ", "target": "${level}", "previous": "48", "next": "50", "timeout": "200" } },
    { "id": "compress", "type": "click_slot", "x": 480, "y": 180, "params": { "slot": "52", "shift": "true" } },
    { "id": "pause", "type": "wait", "x": 640, "y": 180, "params": { "ticks": "8" } },
    { "id": "nextLevel", "type": "calculate", "x": 800, "y": 180, "params": { "name": "level", "operator": "+", "value": "1" } },
    { "id": "lastLevel", "type": "if_compare", "x": 960, "y": 180, "params": { "a": "${level}", "operator": ">", "b": "5" } },
    { "id": "restart", "type": "set_variable", "x": 960, "y": 280, "params": { "name": "level", "value": "1" } },
    { "id": "error", "type": "message", "x": 480, "y": 420, "params": { "text": "§cAutoComp: Das Menü hat nicht reagiert." } },
    { "id": "end", "type": "stop", "x": 800, "y": 420, "params": {} },
    { "id": "escape", "type": "on_key", "x": 480, "y": 330, "params": { "key": "ESCAPE", "autostart": "false" } }
  ],
  "connections": [
    { "from": "start", "output": "next", "to": "open" },
    { "from": "open", "output": "next", "to": "waitMain" },
    { "from": "waitMain", "output": "ok", "to": "openComp" },
    { "from": "waitMain", "output": "timeout", "to": "error" },
    { "from": "openComp", "output": "next", "to": "waitRecipes" },
    { "from": "waitRecipes", "output": "ok", "to": "chooseItem" },
    { "from": "waitRecipes", "output": "timeout", "to": "error" },
    { "from": "chooseItem", "output": "next", "to": "waitComp" },
    { "from": "waitComp", "output": "ok", "to": "firstLevel" },
    { "from": "waitComp", "output": "timeout", "to": "error" },
    { "from": "firstLevel", "output": "next", "to": "stillOpen" },
    { "from": "stillOpen", "output": "yes", "to": "gotoLevel" },
    { "from": "stillOpen", "output": "no", "to": "end" },
    { "from": "gotoLevel", "output": "reached", "to": "compress" },
    { "from": "gotoLevel", "output": "timeout", "to": "error" },
    { "from": "compress", "output": "next", "to": "pause" },
    { "from": "pause", "output": "next", "to": "nextLevel" },
    { "from": "nextLevel", "output": "next", "to": "lastLevel" },
    { "from": "lastLevel", "output": "yes", "to": "restart" },
    { "from": "lastLevel", "output": "no", "to": "stillOpen" },
    { "from": "restart", "output": "next", "to": "stillOpen" },
    { "from": "error", "output": "next", "to": "end" },
    { "from": "escape", "output": "next", "to": "end" }
  ]
}
