{
  "name": "AutoHopper",
  "hotkey": [],
  "nodes": [
    { "id": "opened", "type": "on_menu_open", "x": 0, "y": 0, "params": { "title": "=Trichter-Einstellungen", "autostart": "false" } },
    { "id": "enabled", "type": "if_compare", "x": 160, "y": 0, "params": { "a": "${setting.hopper.enabled}", "operator": "=", "b": "true" } },
    { "id": "noBorder", "type": "set_variable", "x": 320, "y": 0, "params": { "name": "border", "value": "0" } },
    { "id": "stillOpen", "type": "if_menu", "x": 480, "y": 0, "params": { "title": "=Trichter-Einstellungen" } },

    { "id": "filterOn", "type": "if_compare", "x": 640, "y": 0, "params": { "a": "${setting.hopper.filter}", "operator": "=", "b": "true" } },
    { "id": "storeFilter", "type": "store_slot", "x": 800, "y": 0, "params": { "slot": "28", "name": "filter" } },
    { "id": "storeSource", "type": "store_slot", "x": 960, "y": 0, "params": { "slot": "72", "name": "source" } },
    { "id": "sameFilter", "type": "if_compare", "x": 1120, "y": 0, "params": { "a": "${filter.id}", "operator": "=", "b": "${source.id}" } },
    { "id": "setFilter", "type": "click_slot", "x": 1280, "y": 0, "params": { "slot": "72", "shift": "true" } },

    { "id": "radiusOn", "type": "if_compare", "x": 640, "y": 160, "params": { "a": "${setting.hopper.radius}", "operator": ">=", "b": "0" } },
    { "id": "borderReached", "type": "if_compare", "x": 800, "y": 160, "params": { "a": "${border}", "operator": "=", "b": "1" } },
    { "id": "radiusZero", "type": "if_compare", "x": 960, "y": 160, "params": { "a": "${setting.hopper.radius}", "operator": "=", "b": "0" } },
    { "id": "radiusEnabled", "type": "if_slot", "x": 1120, "y": 110, "params": { "slot": "30", "item": "skull" } },
    { "id": "disableRadius", "type": "click_slot", "x": 1280, "y": 110, "params": { "slot": "30", "shift": "true" } },
    { "id": "storeRadius", "type": "store_slot", "x": 1120, "y": 220, "params": { "slot": "31", "name": "radius" } },
    { "id": "radiusTooSmall", "type": "if_compare", "x": 1280, "y": 220, "params": { "a": "${radius.count}", "operator": "<", "b": "${setting.hopper.radius}" } },
    { "id": "increaseRadius", "type": "click_slot", "x": 1440, "y": 220, "params": { "slot": "32", "shift": "true" } },
    { "id": "radiusTooBig", "type": "if_compare", "x": 1280, "y": 330, "params": { "a": "${radius.count}", "operator": ">", "b": "${setting.hopper.radius}" } },
    { "id": "decreaseRadius", "type": "click_slot", "x": 1440, "y": 330, "params": { "slot": "30", "shift": "true" } },

    { "id": "sizeNone", "type": "if_compare", "x": 640, "y": 440, "params": { "a": "${setting.hopper.stackSize}", "operator": "=", "b": "NONE" } },
    { "id": "sizeSingle", "type": "if_compare", "x": 800, "y": 440, "params": { "a": "${setting.hopper.stackSize}", "operator": "=", "b": "SINGLEITEM" } },
    { "id": "targetSingle", "type": "set_variable", "x": 960, "y": 400, "params": { "name": "size", "value": "1" } },
    { "id": "sizeTwelve", "type": "if_compare", "x": 800, "y": 550, "params": { "a": "${setting.hopper.stackSize}", "operator": "=", "b": "TWELVE" } },
    { "id": "targetTwelve", "type": "set_variable", "x": 960, "y": 510, "params": { "name": "size", "value": "12" } },
    { "id": "targetStack", "type": "set_variable", "x": 960, "y": 610, "params": { "name": "size", "value": "64" } },
    { "id": "storeSize", "type": "store_slot", "x": 1120, "y": 510, "params": { "slot": "10", "name": "stack" } },
    { "id": "sizeOk", "type": "if_compare", "x": 1280, "y": 510, "params": { "a": "${stack.count}", "operator": "=", "b": "${size}" } },
    { "id": "changeSize", "type": "click_slot", "x": 1440, "y": 510, "params": { "slot": "10", "shift": "true" } },

    { "id": "pause", "type": "wait", "x": 1600, "y": 220, "params": { "ticks": "5" } },

    { "id": "hasItem", "type": "if_slot", "x": 640, "y": 720, "params": { "slot": "10", "item": "" } },
    { "id": "actionClose", "type": "if_compare", "x": 800, "y": 720, "params": { "a": "${setting.hopper.finalAction}", "operator": "=", "b": "CLOSE" } },
    { "id": "close", "type": "close_menu", "x": 960, "y": 680, "params": {} },
    { "id": "actionConnect", "type": "if_compare", "x": 800, "y": 830, "params": { "a": "${setting.hopper.finalAction}", "operator": "=", "b": "CONNECT" } },
    { "id": "connect", "type": "click_slot", "x": 960, "y": 790, "params": { "slot": "16", "shift": "false" } },
    { "id": "actionMulti", "type": "if_compare", "x": 800, "y": 940, "params": { "a": "${setting.hopper.finalAction}", "operator": "=", "b": "MULTICONNECTION" } },
    { "id": "multi", "type": "click_slot", "x": 960, "y": 900, "params": { "slot": "15", "shift": "false" } },
    { "id": "waitMulti", "type": "wait_for_menu", "x": 1120, "y": 900, "params": { "title": "=Trichter-Mehrfach-Verbindungen", "timeout": "60" } },
    { "id": "addMulti", "type": "click_slot", "x": 1280, "y": 900, "params": { "slot": "53", "shift": "false" } },
    { "id": "end", "type": "stop", "x": 1440, "y": 800, "params": {} },

    { "id": "border", "type": "on_chat", "x": 0, "y": 160, "params": { "contains": "Das Ende vom Grundstück wurde erreicht.", "autostart": "false" } },
    { "id": "markBorder", "type": "set_variable", "x": 160, "y": 160, "params": { "name": "border", "value": "1" } }
  ],
  "connections": [
    { "from": "opened", "output": "next", "to": "enabled" },
    { "from": "enabled", "output": "yes", "to": "noBorder" },
    { "from": "enabled", "output": "no", "to": "end" },
    { "from": "noBorder", "output": "next", "to": "stillOpen" },
    { "from": "stillOpen", "output": "yes", "to": "filterOn" },
    { "from": "stillOpen", "output": "no", "to": "end" },

    { "from": "filterOn", "output": "yes", "to": "storeFilter" },
    { "from": "filterOn", "output": "no", "to": "radiusOn" },
    { "from": "storeFilter", "output": "found", "to": "storeSource" },
    { "from": "storeFilter", "output": "none", "to": "radiusOn" },
    { "from": "storeSource", "output": "found", "to": "sameFilter" },
    { "from": "storeSource", "output": "none", "to": "radiusOn" },
    { "from": "sameFilter", "output": "yes", "to": "radiusOn" },
    { "from": "sameFilter", "output": "no", "to": "setFilter" },
    { "from": "setFilter", "output": "next", "to": "pause" },

    { "from": "radiusOn", "output": "yes", "to": "borderReached" },
    { "from": "radiusOn", "output": "no", "to": "sizeNone" },
    { "from": "borderReached", "output": "yes", "to": "sizeNone" },
    { "from": "borderReached", "output": "no", "to": "radiusZero" },
    { "from": "radiusZero", "output": "yes", "to": "radiusEnabled" },
    { "from": "radiusZero", "output": "no", "to": "storeRadius" },
    { "from": "radiusEnabled", "output": "yes", "to": "disableRadius" },
    { "from": "radiusEnabled", "output": "no", "to": "sizeNone" },
    { "from": "disableRadius", "output": "next", "to": "pause" },
    { "from": "storeRadius", "output": "found", "to": "radiusTooSmall" },
    { "from": "storeRadius", "output": "none", "to": "sizeNone" },
    { "from": "radiusTooSmall", "output": "yes", "to": "increaseRadius" },
    { "from": "radiusTooSmall", "output": "no", "to": "radiusTooBig" },
    { "from": "increaseRadius", "output": "next", "to": "pause" },
    { "from": "radiusTooBig", "output": "yes", "to": "decreaseRadius" },
    { "from": "radiusTooBig", "output": "no", "to": "sizeNone" },
    { "from": "decreaseRadius", "output": "next", "to": "pause" },

    { "from": "sizeNone", "output": "yes", "to": "hasItem" },
    { "from": "sizeNone", "output": "no", "to": "sizeSingle" },
    { "from": "sizeSingle", "output": "yes", "to": "targetSingle" },
    { "from": "sizeSingle", "output": "no", "to": "sizeTwelve" },
    { "from": "sizeTwelve", "output": "yes", "to": "targetTwelve" },
    { "from": "sizeTwelve", "output": "no", "to": "targetStack" },
    { "from": "targetSingle", "output": "next", "to": "storeSize" },
    { "from": "targetTwelve", "output": "next", "to": "storeSize" },
    { "from": "targetStack", "output": "next", "to": "storeSize" },
    { "from": "storeSize", "output": "found", "to": "sizeOk" },
    { "from": "storeSize", "output": "none", "to": "hasItem" },
    { "from": "sizeOk", "output": "yes", "to": "hasItem" },
    { "from": "sizeOk", "output": "no", "to": "changeSize" },
    { "from": "changeSize", "output": "next", "to": "pause" },

    { "from": "pause", "output": "next", "to": "stillOpen" },

    { "from": "hasItem", "output": "yes", "to": "actionClose" },
    { "from": "hasItem", "output": "no", "to": "end" },
    { "from": "actionClose", "output": "yes", "to": "close" },
    { "from": "actionClose", "output": "no", "to": "actionConnect" },
    { "from": "close", "output": "next", "to": "end" },
    { "from": "actionConnect", "output": "yes", "to": "connect" },
    { "from": "actionConnect", "output": "no", "to": "actionMulti" },
    { "from": "connect", "output": "next", "to": "end" },
    { "from": "actionMulti", "output": "yes", "to": "multi" },
    { "from": "actionMulti", "output": "no", "to": "end" },
    { "from": "multi", "output": "next", "to": "waitMulti" },
    { "from": "waitMulti", "output": "ok", "to": "addMulti" },
    { "from": "waitMulti", "output": "timeout", "to": "end" },
    { "from": "addMulti", "output": "next", "to": "end" },

    { "from": "border", "output": "next", "to": "markBorder" },
    { "from": "markBorder", "output": "next", "to": "stillOpen" }
  ]
}
