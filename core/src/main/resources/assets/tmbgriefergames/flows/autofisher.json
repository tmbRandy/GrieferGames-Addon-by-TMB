{
  "name": "AutoFisher",
  "silent": true,
  "hotkey": [],
  "nodes": [
    { "id": "bite", "type": "on_fish_bite", "x": 0, "y": 0, "params": { "autostart": "false" } },
    { "id": "enabled", "type": "if_compare", "x": 160, "y": 0, "params": { "a": "${setting.autoFisher.enabled}", "operator": "=", "b": "true" } },
    { "id": "holdingRod", "type": "if_holding", "x": 320, "y": 0, "params": { "item": "fishing_rod" } },
    { "id": "reelIn", "type": "use_item", "x": 480, "y": 0, "params": {} },
    { "id": "waitCatch", "type": "wait", "x": 640, "y": 0, "params": { "ticks": "20" } },
    { "id": "rodOk", "type": "if_durability", "x": 800, "y": 0, "params": { "min": "2" } },
    { "id": "cast", "type": "use_item", "x": 960, "y": 0, "params": {} },

    { "id": "noRubbish", "type": "set_variable", "x": 960, "y": 120, "params": { "name": "rubbish", "value": "" } },
    { "id": "dropRods", "type": "if_compare", "x": 1120, "y": 120, "params": { "a": "${setting.autoFisher.dropRods}", "operator": "=", "b": "true" } },
    { "id": "addRods", "type": "set_variable", "x": 1280, "y": 80, "params": { "name": "rubbish", "value": "${rubbish},fishing_rod" } },
    { "id": "dropBows", "type": "if_compare", "x": 1120, "y": 220, "params": { "a": "${setting.autoFisher.dropBows}", "operator": "=", "b": "true" } },
    { "id": "addBows", "type": "set_variable", "x": 1280, "y": 180, "params": { "name": "rubbish", "value": "${rubbish},bow" } },
    { "id": "dropBooks", "type": "if_compare", "x": 1120, "y": 320, "params": { "a": "${setting.autoFisher.dropBooks}", "operator": "=", "b": "true" } },
    { "id": "addBooks", "type": "set_variable", "x": 1280, "y": 280, "params": { "name": "rubbish", "value": "${rubbish},enchanted_book" } },
    { "id": "dropSaddles", "type": "if_compare", "x": 1120, "y": 420, "params": { "a": "${setting.autoFisher.dropSaddles}", "operator": "=", "b": "true" } },
    { "id": "addSaddles", "type": "set_variable", "x": 1280, "y": 380, "params": { "name": "rubbish", "value": "${rubbish},saddle" } },
    { "id": "dropLilypads", "type": "if_compare", "x": 1120, "y": 520, "params": { "a": "${setting.autoFisher.dropLilypads}", "operator": "=", "b": "true" } },
    { "id": "addLilypads", "type": "set_variable", "x": 1280, "y": 480, "params": { "name": "rubbish", "value": "${rubbish},waterlily" } },
    { "id": "dropFish", "type": "if_compare", "x": 1120, "y": 620, "params": { "a": "${setting.autoFisher.dropFish}", "operator": "=", "b": "true" } },
    { "id": "addFish", "type": "set_variable", "x": 1280, "y": 580, "params": { "name": "rubbish", "value": "${rubbish},fish,cooked_fish" } },
    { "id": "anyRubbish", "type": "if_compare", "x": 1440, "y": 620, "params": { "a": "${rubbish}", "operator": "!=", "b": "" } },
    { "id": "drop", "type": "drop_items", "x": 1600, "y": 620, "params": { "item": "${rubbish}", "keep_one": "false", "area": "inventory", "slots": "", "min_level": "0", "max_level": "7", "named": "no", "exclude": "" } },
    { "id": "enderChest", "type": "if_menu", "x": 1760, "y": 620, "params": { "title": "Endertruhe" } },
    { "id": "ecAllowed", "type": "if_compare", "x": 1920, "y": 620, "params": { "a": "${setting.autoFisher.allowEC}", "operator": "=", "b": "true" } },
    { "id": "store", "type": "move_items", "x": 2080, "y": 620, "params": { "item": "", "max_stacks": "0", "full_only": "false", "area": "inventory", "slots": "", "min_level": "0", "max_level": "7", "named": "", "exclude": "fishing_rod,${rubbish}" } },

    { "id": "nextRod", "type": "find_slot", "x": 800, "y": 160, "params": { "item": "fishing_rod", "variable": "rod", "full_stack": "false", "area": "inventory", "slots": "36-44", "min_level": "0", "max_level": "7", "named": "", "exclude": "" } },
    { "id": "rodToHotbar", "type": "set_variable", "x": 960, "y": 300, "params": { "name": "hotbar", "value": "${rod}" } },
    { "id": "hotbarIndex", "type": "calculate", "x": 960, "y": 380, "params": { "name": "hotbar", "operator": "-", "value": "35" } },
    { "id": "selectRod", "type": "select_slot", "x": 800, "y": 380, "params": { "slot": "${hotbar}" } },
    { "id": "checkNewRod", "type": "if_durability", "x": 640, "y": 380, "params": { "min": "2" } },
    { "id": "broken", "type": "message", "x": 640, "y": 160, "params": { "text": "§cAutoFisher: Keine heile Angel in der Hotbar." } },

    { "id": "removerWarning", "type": "on_chat", "x": 0, "y": 500, "params": { "contains": "Warnung! Die auf dem Boden liegenden Items werden in 20 Sekunden entfernt!", "autostart": "false" } },
    { "id": "pullIn", "type": "use_item", "x": 160, "y": 500, "params": {} },
    { "id": "waitRemover", "type": "wait_for_chat", "x": 320, "y": 500, "params": { "contains": "auf dem Boden liegende Items entfernt!", "timeout": "800", "variable": "" } },
    { "id": "castAgain", "type": "use_item", "x": 480, "y": 500, "params": {} },

    { "id": "end", "type": "stop", "x": 480, "y": 280, "params": {} }
  ],
  "connections": [
    { "from": "bite", "output": "next", "to": "enabled" },
    { "from": "enabled", "output": "yes", "to": "holdingRod" },
    { "from": "enabled", "output": "no", "to": "end" },
    { "from": "holdingRod", "output": "yes", "to": "reelIn" },
    { "from": "holdingRod", "output": "no", "to": "end" },
    { "from": "reelIn", "output": "next", "to": "waitCatch" },
    { "from": "waitCatch", "output": "next", "to": "rodOk" },
    { "from": "rodOk", "output": "yes", "to": "cast" },
    { "from": "rodOk", "output": "no", "to": "nextRod" },
    { "from": "cast", "output": "next", "to": "noRubbish" },

    { "from": "noRubbish", "output": "next", "to": "dropRods" },
    { "from": "dropRods", "output": "yes", "to": "addRods" },
    { "from": "dropRods", "output": "no", "to": "dropBows" },
    { "from": "addRods", "output": "next", "to": "dropBows" },
    { "from": "dropBows", "output": "yes", "to": "addBows" },
    { "from": "dropBows", "output": "no", "to": "dropBooks" },
    { "from": "addBows", "output": "next", "to": "dropBooks" },
    { "from": "dropBooks", "output": "yes", "to": "addBooks" },
    { "from": "dropBooks", "output": "no", "to": "dropSaddles" },
    { "from": "addBooks", "output": "next", "to": "dropSaddles" },
    { "from": "dropSaddles", "output": "yes", "to": "addSaddles" },
    { "from": "dropSaddles", "output": "no", "to": "dropLilypads" },
    { "from": "addSaddles", "output": "next", "to": "dropLilypads" },
    { "from": "dropLilypads", "output": "yes", "to": "addLilypads" },
    { "from": "dropLilypads", "output": "no", "to": "dropFish" },
    { "from": "addLilypads", "output": "next", "to": "dropFish" },
    { "from": "dropFish", "output": "yes", "to": "addFish" },
    { "from": "dropFish", "output": "no", "to": "anyRubbish" },
    { "from": "addFish", "output": "next", "to": "anyRubbish" },
    { "from": "anyRubbish", "output": "yes", "to": "drop" },
    { "from": "anyRubbish", "output": "no", "to": "enderChest" },
    { "from": "drop", "output": "next", "to": "enderChest" },
    { "from": "enderChest", "output": "yes", "to": "ecAllowed" },
    { "from": "enderChest", "output": "no", "to": "end" },
    { "from": "ecAllowed", "output": "yes", "to": "store" },
    { "from": "ecAllowed", "output": "no", "to": "end" },
    { "from": "store", "output": "next", "to": "end" },

    { "from": "nextRod", "output": "found", "to": "rodToHotbar" },
    { "from": "nextRod", "output": "none", "to": "broken" },
    { "from": "rodToHotbar", "output": "next", "to": "hotbarIndex" },
    { "from": "hotbarIndex", "output": "next", "to": "selectRod" },
    { "from": "selectRod", "output": "next", "to": "checkNewRod" },
    { "from": "checkNewRod", "output": "yes", "to": "cast" },
    { "from": "checkNewRod", "output": "no", "to": "broken" },
    { "from": "broken", "output": "next", "to": "end" },

    { "from": "removerWarning", "output": "next", "to": "pullIn" },
    { "from": "pullIn", "output": "next", "to": "waitRemover" },
    { "from": "waitRemover", "output": "ok", "to": "castAgain" },
    { "from": "waitRemover", "output": "timeout", "to": "castAgain" },
    { "from": "castAgain", "output": "next", "to": "end" }
  ]
}
