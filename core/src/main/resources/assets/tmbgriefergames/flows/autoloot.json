{
  "name": "AutoLoot",
  "silent": true,
  "hotkey": [],
  "nodes": [
    { "id": "joined", "type": "on_chat", "x": 0, "y": 0, "params": { "contains": "=[Switcher] Daten heruntergeladen!", "autostart": "false" } },
    { "id": "enabled", "type": "if_compare", "x": 160, "y": 0, "params": { "a": "${setting.autoLoot}", "operator": "=", "b": "true" } },
    { "id": "settle", "type": "wait", "x": 320, "y": 0, "params": { "ticks": "100" } },
    { "id": "info", "type": "store_info", "x": 480, "y": 0, "params": { "name": "info" } },
    { "id": "noPlotWorld", "type": "if_compare", "x": 640, "y": 0, "params": { "a": "LOBBY PORTAL NONE LAVA WASSER", "operator": "contains", "b": "${info.cb}" } },
    { "id": "noChestRank", "type": "if_compare", "x": 800, "y": 0, "params": { "a": "Spieler Premium Ultra Legende Titan", "operator": "contains", "b": "${info.rank}" } },
    { "id": "boosterDue", "type": "if_compare", "x": 960, "y": -80, "params": { "a": "${time.now}", "operator": ">=", "b": "${saved.freeBooster}" } },
    { "id": "booster", "type": "command", "x": 1120, "y": -120, "params": { "command": "/grieferboost" } },
    { "id": "chestDue", "type": "if_compare", "x": 1280, "y": -80, "params": { "a": "${time.now}", "operator": ">=", "b": "${saved.freeChest}" } },
    { "id": "chest", "type": "command", "x": 1440, "y": -120, "params": { "command": "/freekiste" } },
    { "id": "noSkullRank", "type": "if_compare", "x": 960, "y": 100, "params": { "a": "Spieler Premium Ultra Legende", "operator": "contains", "b": "${info.rank}" } },
    { "id": "skullKnown", "type": "if_compare", "x": 1120, "y": 100, "params": { "a": "${saved.freeSkull}", "operator": "!=", "b": "" } },
    { "id": "skullDue", "type": "if_compare", "x": 1280, "y": 100, "params": { "a": "${time.now}", "operator": ">=", "b": "${saved.freeSkull}" } },
    { "id": "skullMessage", "type": "message", "x": 1440, "y": 100, "params": { "text": "§aDu kannst dir wieder einen Kopf abholen!" } },

    { "id": "chestTimer", "type": "on_chat", "x": 0, "y": 280, "params": { "contains": "wieder Free-Kisten abholen", "autostart": "false" } },
    { "id": "chestTimerDate", "type": "extract_text", "x": 160, "y": 280, "params": { "text": "${event}", "after": "erst am ", "before": " wieder", "name": "dateText" } },
    { "id": "chestTimerParse", "type": "parse_date", "x": 320, "y": 280, "params": { "text": "${dateText}", "format": "dd.MM.yyyy 'um' HH:mm:ss", "name": "date" } },
    { "id": "chestTimerSave", "type": "set_variable", "x": 480, "y": 280, "params": { "name": "saved.freeChest", "value": "${date}" } },

    { "id": "boosterTimer", "type": "on_chat", "x": 0, "y": 380, "params": { "contains": "wieder einen Free-Booster abholen", "autostart": "false" } },
    { "id": "boosterTimerDate", "type": "extract_text", "x": 160, "y": 380, "params": { "text": "${event}", "after": "erst am ", "before": " wieder", "name": "dateText" } },
    { "id": "boosterTimerParse", "type": "parse_date", "x": 320, "y": 380, "params": { "text": "${dateText}", "format": "dd.MM.yyyy 'um' HH:mm:ss", "name": "date" } },
    { "id": "boosterTimerSave", "type": "set_variable", "x": 480, "y": 380, "params": { "name": "saved.freeBooster", "value": "${date}" } },

    { "id": "chestReceived", "type": "on_chat", "x": 0, "y": 500, "params": { "contains": "=[CaseOpening] Du hast 2 Kisten erhalten.", "autostart": "false" } },
    { "id": "chestNow", "type": "set_variable", "x": 160, "y": 500, "params": { "name": "next", "value": "${time.now}" } },
    { "id": "chestPlus", "type": "calculate", "x": 320, "y": 500, "params": { "name": "next", "operator": "+", "value": "1209600" } },
    { "id": "chestSave", "type": "set_variable", "x": 480, "y": 500, "params": { "name": "saved.freeChest", "value": "${next}" } },

    { "id": "boosterReceived", "type": "on_chat", "x": 0, "y": 600, "params": { "contains": "-Booster erhalten. Danke für deine Unterstützung von GrieferGames!", "autostart": "false" } },
    { "id": "boosterNow", "type": "set_variable", "x": 160, "y": 600, "params": { "name": "next", "value": "${time.now}" } },
    { "id": "boosterPlus", "type": "calculate", "x": 320, "y": 600, "params": { "name": "next", "operator": "+", "value": "1209600" } },
    { "id": "boosterSave", "type": "set_variable", "x": 480, "y": 600, "params": { "name": "saved.freeBooster", "value": "${next}" } },

    { "id": "skullReceived", "type": "on_chat", "x": 0, "y": 720, "params": { "contains": "-Kopf erhalten!", "autostart": "false" } },
    { "id": "skullInfo", "type": "store_info", "x": 160, "y": 720, "params": { "name": "info" } },
    { "id": "skullNow", "type": "set_variable", "x": 320, "y": 720, "params": { "name": "next", "value": "${time.now}" } },
    { "id": "isTitan", "type": "if_compare", "x": 480, "y": 720, "params": { "a": "${info.rank}", "operator": "=", "b": "Titan" } },
    { "id": "plusTwoWeeks", "type": "calculate", "x": 640, "y": 680, "params": { "name": "next", "operator": "+", "value": "1209600" } },
    { "id": "plusOneWeek", "type": "calculate", "x": 640, "y": 780, "params": { "name": "next", "operator": "+", "value": "604800" } },
    { "id": "skullSave", "type": "set_variable", "x": 800, "y": 720, "params": { "name": "saved.freeSkull", "value": "${next}" } },

    { "id": "end", "type": "stop", "x": 1600, "y": 280, "params": {} }
  ],
  "connections": [
    { "from": "joined", "output": "next", "to": "enabled" },
    { "from": "enabled", "output": "yes", "to": "settle" },
    { "from": "enabled", "output": "no", "to": "end" },
    { "from": "settle", "output": "next", "to": "info" },
    { "from": "info", "output": "next", "to": "noPlotWorld" },
    { "from": "noPlotWorld", "output": "yes", "to": "end" },
    { "from": "noPlotWorld", "output": "no", "to": "noChestRank" },
    { "from": "noChestRank", "output": "yes", "to": "noSkullRank" },
    { "from": "noChestRank", "output": "no", "to": "boosterDue" },
    { "from": "boosterDue", "output": "yes", "to": "booster" },
    { "from": "boosterDue", "output": "no", "to": "chestDue" },
    { "from": "booster", "output": "next", "to": "chestDue" },
    { "from": "chestDue", "output": "yes", "to": "chest" },
    { "from": "chestDue", "output": "no", "to": "noSkullRank" },
    { "from": "chest", "output": "next", "to": "noSkullRank" },
    { "from": "noSkullRank", "output": "yes", "to": "end" },
    { "from": "noSkullRank", "output": "no", "to": "skullKnown" },
    { "from": "skullKnown", "output": "yes", "to": "skullDue" },
    { "from": "skullKnown", "output": "no", "to": "end" },
    { "from": "skullDue", "output": "yes", "to": "skullMessage" },
    { "from": "skullDue", "output": "no", "to": "end" },
    { "from": "skullMessage", "output": "next", "to": "end" },

    { "from": "chestTimer", "output": "next", "to": "chestTimerDate" },
    { "from": "chestTimerDate", "output": "found", "to": "chestTimerParse" },
    { "from": "chestTimerDate", "output": "none", "to": "end" },
    { "from": "chestTimerParse", "output": "found", "to": "chestTimerSave" },
    { "from": "chestTimerParse", "output": "none", "to": "end" },
    { "from": "chestTimerSave", "output": "next", "to": "end" },

    { "from": "boosterTimer", "output": "next", "to": "boosterTimerDate" },
    { "from": "boosterTimerDate", "output": "found", "to": "boosterTimerParse" },
    { "from": "boosterTimerDate", "output": "none", "to": "end" },
    { "from": "boosterTimerParse", "output": "found", "to": "boosterTimerSave" },
    { "from": "boosterTimerParse", "output": "none", "to": "end" },
    { "from": "boosterTimerSave", "output": "next", "to": "end" },

    { "from": "chestReceived", "output": "next", "to": "chestNow" },
    { "from": "chestNow", "output": "next", "to": "chestPlus" },
    { "from": "chestPlus", "output": "next", "to": "chestSave" },
    { "from": "chestSave", "output": "next", "to": "end" },

    { "from": "boosterReceived", "output": "next", "to": "boosterNow" },
    { "from": "boosterNow", "output": "next", "to": "boosterPlus" },
    { "from": "boosterPlus", "output": "next", "to": "boosterSave" },
    { "from": "boosterSave", "output": "next", "to": "end" },

    { "from": "skullReceived", "output": "next", "to": "skullInfo" },
    { "from": "skullInfo", "output": "next", "to": "skullNow" },
    { "from": "skullNow", "output": "next", "to": "isTitan" },
    { "from": "isTitan", "output": "yes", "to": "plusTwoWeeks" },
    { "from": "isTitan", "output": "no", "to": "plusOneWeek" },
    { "from": "plusTwoWeeks", "output": "next", "to": "skullSave" },
    { "from": "plusOneWeek", "output": "next", "to": "skullSave" },
    { "from": "skullSave", "output": "next", "to": "end" }
  ]
}
