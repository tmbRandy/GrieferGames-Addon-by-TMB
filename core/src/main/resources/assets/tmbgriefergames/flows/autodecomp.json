{
  "name": "AutoDecomp",
  "hotkey": [],
  "nodes": [
    { "id": "start", "type": "start", "x": 0, "y": 0, "params": {} },
    { "id": "remember", "type": "store_slot", "x": 160, "y": 0, "params": { "slot": "36", "name": "item" } },
    { "id": "noItem", "type": "message", "x": 160, "y": 110, "params": { "text": "§cAutoDecomp: Lege das Item in deinen ersten Hotbar-Slot." } },
    { "id": "isCrafting", "type": "if_screen", "x": 320, "y": 0, "params": { "screen": "crafting" } },
    { "id": "openCraft", "type": "command", "x": 320, "y": 110, "params": { "command": "/craft" } },
    { "id": "waitCraft", "type": "wait", "x": 480, "y": 110, "params": { "ticks": "40" } },
    { "id": "hasResult", "type": "if_slot", "x": 480, "y": 0, "params": { "slot": "0", "item": "" } },
    { "id": "takeResult", "type": "click_slot", "x": 640, "y": -90, "params": { "slot": "0", "shift": "true" } },
    { "id": "findRaw", "type": "find_slot", "x": 640, "y": 0, "params": { "item": "${item.id}", "variable": "src", "full_stack": "false", "area": "inventory", "slots": "", "min_level": "0", "max_level": "0" } },
    { "id": "dropRaw", "type": "drop_items", "x": 800, "y": -90, "params": { "item": "${item.id}", "keep_one": "false", "area": "inventory", "slots": "", "min_level": "0", "max_level": "0" } },
    { "id": "firstLevel", "type": "set_variable", "x": 800, "y": 60, "params": { "name": "level", "value": "1" } },
    { "id": "findLevel", "type": "find_slot", "x": 960, "y": 60, "params": { "item": "${item.id}", "variable": "src", "full_stack": "false", "area": "inventory", "slots": "", "min_level": "${level}", "max_level": "${level}" } },
    { "id": "pick", "type": "click_slot", "x": 1120, "y": 0, "params": { "slot": "${src}", "shift": "false" } },
    { "id": "place", "type": "click_slot", "x": 1280, "y": 0, "params": { "slot": "5", "shift": "false" } },
    { "id": "pause", "type": "wait", "x": 1440, "y": 0, "params": { "ticks": "5" } },
    { "id": "nextLevel", "type": "calculate", "x": 1120, "y": 170, "params": { "name": "level", "operator": "+", "value": "1" } },
    { "id": "lastLevel", "type": "if_compare", "x": 1280, "y": 170, "params": { "a": "${level}", "operator": ">", "b": "7" } },
    { "id": "done", "type": "message", "x": 1440, "y": 170, "params": { "text": "§aAutoDecomp: Alles dekomprimiert." } },
    { "id": "end", "type": "stop", "x": 1600, "y": 170, "params": {} },
    { "id": "escape", "type": "on_key", "x": 1440, "y": 280, "params": { "key": "ESCAPE", "autostart": "false" } }
  ],
  "connections": [
    { "from": "start", "output": "next", "to": "remember" },
    { "from": "remember", "output": "found", "to": "isCrafting" },
    { "from": "remember", "output": "none", "to": "noItem" },
    { "from": "noItem", "output": "next", "to": "end" },
    { "from": "isCrafting", "output": "yes", "to": "hasResult" },
    { "from": "isCrafting", "output": "no", "to": "openCraft" },
    { "from": "openCraft", "output": "next", "to": "waitCraft" },
    { "from": "waitCraft", "output": "next", "to": "isCrafting" },
    { "from": "hasResult", "output": "yes", "to": "takeResult" },
    { "from": "hasResult", "output": "no", "to": "findRaw" },
    { "from": "takeResult", "output": "next", "to": "isCrafting" },
    { "from": "findRaw", "output": "found", "to": "dropRaw" },
    { "from": "findRaw", "output": "none", "to": "firstLevel" },
    { "from": "dropRaw", "output": "next", "to": "isCrafting" },
    { "from": "firstLevel", "output": "next", "to": "findLevel" },
    { "from": "findLevel", "output": "found", "to": "pick" },
    { "from": "findLevel", "output": "none", "to": "nextLevel" },
    { "from": "pick", "output": "next", "to": "place" },
    { "from": "place", "output": "next", "to": "pause" },
    { "from": "pause", "output": "next", "to": "isCrafting" },
    { "from": "nextLevel", "output": "next", "to": "lastLevel" },
    { "from": "lastLevel", "output": "yes", "to": "done" },
    { "from": "lastLevel", "output": "no", "to": "findLevel" },
    { "from": "done", "output": "next", "to": "end" },
    { "from": "escape", "output": "next", "to": "end" }
  ]
}
