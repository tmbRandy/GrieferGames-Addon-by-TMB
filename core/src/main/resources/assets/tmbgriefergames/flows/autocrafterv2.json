{
  "name": "AutoCrafterV2",
  "hotkey": [],
  "nodes": [
    { "id": "start", "type": "start", "x": 0, "y": 0, "params": {} },
    { "id": "open", "type": "command", "x": 160, "y": 0, "params": { "command": "/rezepte" } },
    { "id": "waitMain", "type": "wait_for_menu", "x": 320, "y": 0, "params": { "title": "=Custom-Kategorien", "timeout": "100" } },
    { "id": "openRecipes", "type": "click_slot", "x": 480, "y": 0, "params": { "slot": "12", "shift": "true" } },
    { "id": "waitRecipes", "type": "wait_for_menu", "x": 640, "y": 0, "params": { "title": "=Minecraft-Rezepte", "timeout": "100" } },
    { "id": "hint", "type": "message", "x": 800, "y": 0, "params": { "text": "§eAutoCrafter V2: Klicke das Rezept an, das gecraftet werden soll." } },
    { "id": "waitRecipe", "type": "wait_for_menu", "x": 960, "y": 0, "params": { "title": "=Vanilla Bauanleitung", "timeout": "2400" } },
    { "id": "remember", "type": "store_slot", "x": 1120, "y": 0, "params": { "slot": "25", "name": "craft" } },

    { "id": "stillOpen", "type": "if_menu", "x": 160, "y": 200, "params": { "title": "=Vanilla Bauanleitung" } },
    { "id": "count", "type": "count_items", "x": 320, "y": 200, "params": { "item": "${craft.id}", "variable": "crafted", "area": "inventory", "slots": "", "min_level": "0", "max_level": "7", "named": "", "exclude": "" } },
    { "id": "full", "type": "if_compare", "x": 480, "y": 200, "params": { "a": "${crafted}", "operator": ">=", "b": "27" } },
    { "id": "craft", "type": "click_slot", "x": 640, "y": 140, "params": { "slot": "52", "shift": "true" } },
    { "id": "craftPause", "type": "wait", "x": 800, "y": 140, "params": { "ticks": "7" } },

    { "id": "compress", "type": "if_compare", "x": 640, "y": 300, "params": { "a": "${setting.autoCrafter.finalActionV2}", "operator": "=", "b": "COMP" } },
    { "id": "back", "type": "click_slot", "x": 800, "y": 300, "params": { "slot": "45", "shift": "true" } },
    { "id": "backPause", "type": "wait", "x": 960, "y": 260, "params": { "ticks": "10" } },
    { "id": "atMainComp", "type": "if_menu", "x": 960, "y": 360, "params": { "title": "=Custom-Kategorien" } },
    { "id": "openComp", "type": "click_slot", "x": 1120, "y": 300, "params": { "slot": "11", "shift": "true" } },
    { "id": "waitCompRecipes", "type": "wait_for_menu", "x": 1280, "y": 300, "params": { "title": "=Item-Komprimierung-Bauanleitung", "timeout": "100" } },
    { "id": "findRaw", "type": "find_slot", "x": 1440, "y": 300, "params": { "item": "${craft.id}", "variable": "raw", "full_stack": "false", "area": "inventory", "slots": "", "min_level": "0", "max_level": "0", "named": "", "exclude": "" } },
    { "id": "chooseRaw", "type": "click_slot", "x": 1600, "y": 260, "params": { "slot": "${raw}", "shift": "true" } },
    { "id": "chooseFirst", "type": "click_slot", "x": 1600, "y": 360, "params": { "slot": "81", "shift": "true" } },
    { "id": "waitComp", "type": "wait_for_menu", "x": 1760, "y": 300, "params": { "title": "=Item-Komprimierung", "timeout": "100" } },
    { "id": "firstLevel", "type": "set_variable", "x": 1920, "y": 300, "params": { "name": "level", "value": "1" } },
    { "id": "gotoLevel", "type": "navigate_page", "x": 1920, "y": 420, "params": { "indicator": "49", "prefix": "Komprimierungsstufe ", "target": "${level}", "previous": "48", "next": "50", "timeout": "200" } },
    { "id": "compressLevel", "type": "click_slot", "x": 1760, "y": 420, "params": { "slot": "52", "shift": "true" } },
    { "id": "compPause", "type": "wait", "x": 1600, "y": 480, "params": { "ticks": "8" } },
    { "id": "nextLevel", "type": "calculate", "x": 1440, "y": 480, "params": { "name": "level", "operator": "+", "value": "1" } },
    { "id": "lastLevel", "type": "if_compare", "x": 1280, "y": 480, "params": { "a": "${level}", "operator": ">", "b": "6" } },

    { "id": "backAgain", "type": "click_slot", "x": 1120, "y": 600, "params": { "slot": "45", "shift": "true" } },
    { "id": "backAgainPause", "type": "wait", "x": 1120, "y": 680, "params": { "ticks": "10" } },
    { "id": "atMain", "type": "if_menu", "x": 960, "y": 680, "params": { "title": "=Custom-Kategorien" } },
    { "id": "atRecipes", "type": "if_menu", "x": 800, "y": 680, "params": { "title": "=Minecraft-Rezepte" } },
    { "id": "waitMainAgain", "type": "wait_for_menu", "x": 960, "y": 600, "params": { "title": "=Custom-Kategorien", "timeout": "100" } },
    { "id": "openRecipesAgain", "type": "click_slot", "x": 800, "y": 600, "params": { "slot": "12", "shift": "true" } },
    { "id": "waitRecipesAgain", "type": "wait_for_menu", "x": 640, "y": 600, "params": { "title": "=Minecraft-Rezepte", "timeout": "100" } },
    { "id": "findCraft", "type": "find_slot", "x": 480, "y": 600, "params": { "item": "${craft.id}", "variable": "item", "full_stack": "false", "area": "inventory", "slots": "", "min_level": "0", "max_level": "7", "named": "", "exclude": "" } },
    { "id": "openCraft", "type": "click_slot", "x": 320, "y": 600, "params": { "slot": "${item}", "shift": "true" } },
    { "id": "waitCraft", "type": "wait_for_menu", "x": 160, "y": 600, "params": { "title": "=Vanilla Bauanleitung", "timeout": "100" } },

    { "id": "closeForDrop", "type": "close_menu", "x": 800, "y": 760, "params": {} },
    { "id": "inventory", "type": "open_inventory", "x": 960, "y": 760, "params": {} },
    { "id": "inventoryPause", "type": "wait", "x": 1120, "y": 760, "params": { "ticks": "10" } },
    { "id": "drop", "type": "drop_items", "x": 1280, "y": 760, "params": { "item": "${craft.id}", "keep_one": "true", "area": "inventory", "slots": "", "min_level": "0", "max_level": "7", "named": "", "exclude": "" } },
    { "id": "closeInventory", "type": "close_menu", "x": 1440, "y": 760, "params": {} },
    { "id": "reopen", "type": "command", "x": 1600, "y": 760, "params": { "command": "/rezepte" } },

    { "id": "error", "type": "message", "x": 320, "y": 860, "params": { "text": "§cAutoCrafter V2: Ein Menü hat nicht reagiert." } },
    { "id": "end", "type": "stop", "x": 160, "y": 860, "params": {} },
    { "id": "escape", "type": "on_key", "x": 0, "y": 760, "params": { "key": "ESCAPE", "setting": "", "autostart": "false" } }
  ],
  "connections": [
    { "from": "start", "output": "next", "to": "open" },
    { "from": "open", "output": "next", "to": "waitMain" },
    { "from": "waitMain", "output": "ok", "to": "openRecipes" },
    { "from": "waitMain", "output": "timeout", "to": "error" },
    { "from": "openRecipes", "output": "next", "to": "waitRecipes" },
    { "from": "waitRecipes", "output": "ok", "to": "hint" },
    { "from": "waitRecipes", "output": "timeout", "to": "error" },
    { "from": "hint", "output": "next", "to": "waitRecipe" },
    { "from": "waitRecipe", "output": "ok", "to": "remember" },
    { "from": "waitRecipe", "output": "timeout", "to": "end" },
    { "from": "remember", "output": "found", "to": "stillOpen" },
    { "from": "remember", "output": "none", "to": "error" },

    { "from": "stillOpen", "output": "yes", "to": "count" },
    { "from": "stillOpen", "output": "no", "to": "end" },
    { "from": "count", "output": "next", "to": "full" },
    { "from": "full", "output": "no", "to": "craft" },
    { "from": "full", "output": "yes", "to": "compress" },
    { "from": "craft", "output": "next", "to": "craftPause" },
    { "from": "craftPause", "output": "next", "to": "stillOpen" },

    { "from": "compress", "output": "yes", "to": "back" },
    { "from": "compress", "output": "no", "to": "closeForDrop" },
    { "from": "back", "output": "next", "to": "backPause" },
    { "from": "backPause", "output": "next", "to": "atMainComp" },
    { "from": "atMainComp", "output": "yes", "to": "openComp" },
    { "from": "atMainComp", "output": "no", "to": "back" },
    { "from": "openComp", "output": "next", "to": "waitCompRecipes" },
    { "from": "waitCompRecipes", "output": "ok", "to": "findRaw" },
    { "from": "waitCompRecipes", "output": "timeout", "to": "error" },
    { "from": "findRaw", "output": "found", "to": "chooseRaw" },
    { "from": "findRaw", "output": "none", "to": "chooseFirst" },
    { "from": "chooseRaw", "output": "next", "to": "waitComp" },
    { "from": "chooseFirst", "output": "next", "to": "waitComp" },
    { "from": "waitComp", "output": "ok", "to": "firstLevel" },
    { "from": "waitComp", "output": "timeout", "to": "error" },
    { "from": "firstLevel", "output": "next", "to": "gotoLevel" },
    { "from": "gotoLevel", "output": "reached", "to": "compressLevel" },
    { "from": "gotoLevel", "output": "timeout", "to": "end" },
    { "from": "compressLevel", "output": "next", "to": "compPause" },
    { "from": "compPause", "output": "next", "to": "nextLevel" },
    { "from": "nextLevel", "output": "next", "to": "lastLevel" },
    { "from": "lastLevel", "output": "yes", "to": "backAgain" },
    { "from": "lastLevel", "output": "no", "to": "gotoLevel" },

    { "from": "backAgain", "output": "next", "to": "backAgainPause" },
    { "from": "backAgainPause", "output": "next", "to": "atMain" },
    { "from": "atMain", "output": "yes", "to": "openRecipesAgain" },
    { "from": "atMain", "output": "no", "to": "atRecipes" },
    { "from": "atRecipes", "output": "yes", "to": "findCraft" },
    { "from": "atRecipes", "output": "no", "to": "backAgain" },
    { "from": "waitMainAgain", "output": "ok", "to": "openRecipesAgain" },
    { "from": "waitMainAgain", "output": "timeout", "to": "error" },
    { "from": "openRecipesAgain", "output": "next", "to": "waitRecipesAgain" },
    { "from": "waitRecipesAgain", "output": "ok", "to": "findCraft" },
    { "from": "waitRecipesAgain", "output": "timeout", "to": "error" },
    { "from": "findCraft", "output": "found", "to": "openCraft" },
    { "from": "findCraft", "output": "none", "to": "error" },
    { "from": "openCraft", "output": "next", "to": "waitCraft" },
    { "from": "waitCraft", "output": "ok", "to": "stillOpen" },
    { "from": "waitCraft", "output": "timeout", "to": "error" },

    { "from": "closeForDrop", "output": "next", "to": "inventory" },
    { "from": "inventory", "output": "next", "to": "inventoryPause" },
    { "from": "inventoryPause", "output": "next", "to": "drop" },
    { "from": "drop", "output": "next", "to": "closeInventory" },
    { "from": "closeInventory", "output": "next", "to": "reopen" },
    { "from": "reopen", "output": "next", "to": "waitMainAgain" },

    { "from": "error", "output": "next", "to": "end" },
    { "from": "escape", "output": "next", "to": "end" }
  ]
}
