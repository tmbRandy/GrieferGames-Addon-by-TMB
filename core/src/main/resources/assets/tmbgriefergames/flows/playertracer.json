{
  "name": "Fahndung",
  "hotkey": [],
  "nodes": [
    { "id": "start", "type": "start", "x": 0, "y": 0, "params": {} },
    { "id": "searching", "type": "if_compare", "x": 160, "y": 0, "params": { "a": "${arg1}", "operator": "!=", "b": "" } },
    { "id": "lookingFor", "type": "message", "x": 320, "y": -80, "params": { "text": "Suche nach §e${arg1}§f gestartet. Bewegen (W, A, S, D) bricht ab." } },
    { "id": "hopping", "type": "message", "x": 320, "y": 80, "params": { "text": "Alle CBs werden besucht. Bewegen (W, A, S, D) bricht ab." } },
    { "id": "list", "type": "set_variable", "x": 480, "y": 0, "params": { "name": "cbs", "value": "cb1 cb22 cb21 cb20 cb7 nature cb2 cb3 cb4 cb5 cb6 cb8 cb9 cb10 cb11 cb12 cb13 cb14 cb15 cb16 cb17 cb18 cb19 extreme cbe" } },
    { "id": "split", "type": "split_text", "x": 640, "y": 0, "params": { "text": "${cbs}", "separator": " ", "name": "cb" } },
    { "id": "first", "type": "set_variable", "x": 800, "y": 0, "params": { "name": "index", "value": "1" } },

    { "id": "switch", "type": "command", "x": 160, "y": 220, "params": { "command": "/switch ${cb.${index}}" } },
    { "id": "waitData", "type": "wait_for_chat", "x": 320, "y": 220, "params": { "contains": "[Switcher] Daten heruntergeladen!", "timeout": "600", "variable": "" } },
    { "id": "settle", "type": "wait", "x": 480, "y": 220, "params": { "ticks": "20" } },
    { "id": "lookFor", "type": "if_compare", "x": 640, "y": 220, "params": { "a": "${arg1}", "operator": "!=", "b": "" } },
    { "id": "online", "type": "if_player_online", "x": 800, "y": 160, "params": { "player": "${arg1}" } },
    { "id": "found", "type": "message", "x": 960, "y": 100, "params": { "text": "§a${arg1} ist auf ${cb.${index}}!" } },
    { "id": "nextCb", "type": "calculate", "x": 960, "y": 260, "params": { "name": "index", "operator": "+", "value": "1" } },
    { "id": "lastCb", "type": "if_compare", "x": 1120, "y": 260, "params": { "a": "${index}", "operator": ">", "b": "${cb.count}" } },
    { "id": "allVisited", "type": "message", "x": 1280, "y": 200, "params": { "text": "Alle CBs wurden besucht." } },
    { "id": "pause", "type": "wait", "x": 1280, "y": 320, "params": { "ticks": "120" } },

    { "id": "kicked", "type": "on_chat", "x": 0, "y": 420, "params": { "contains": "Du hast dich zu schnell wieder eingeloggt", "autostart": "false" } },
    { "id": "retryPause", "type": "wait", "x": 160, "y": 420, "params": { "ticks": "20" } },
    { "id": "keyW", "type": "on_key", "x": 480, "y": 420, "params": { "key": "W", "setting": "", "autostart": "false" } },
    { "id": "keyA", "type": "on_key", "x": 480, "y": 500, "params": { "key": "A", "setting": "", "autostart": "false" } },
    { "id": "keyS", "type": "on_key", "x": 480, "y": 580, "params": { "key": "S", "setting": "", "autostart": "false" } },
    { "id": "keyD", "type": "on_key", "x": 480, "y": 660, "params": { "key": "D", "setting": "", "autostart": "false" } },
    { "id": "end", "type": "stop", "x": 800, "y": 500, "params": {} }
  ],
  "connections": [
    { "from": "start", "output": "next", "to": "searching" },
    { "from": "searching", "output": "yes", "to": "lookingFor" },
    { "from": "searching", "output": "no", "to": "hopping" },
    { "from": "lookingFor", "output": "next", "to": "list" },
    { "from": "hopping", "output": "next", "to": "list" },
    { "from": "list", "output": "next", "to": "split" },
    { "from": "split", "output": "next", "to": "first" },
    { "from": "first", "output": "next", "to": "switch" },

    { "from": "switch", "output": "next", "to": "waitData" },
    { "from": "waitData", "output": "ok", "to": "settle" },
    { "from": "waitData", "output": "timeout", "to": "switch" },
    { "from": "settle", "output": "next", "to": "lookFor" },
    { "from": "lookFor", "output": "yes", "to": "online" },
    { "from": "lookFor", "output": "no", "to": "nextCb" },
    { "from": "online", "output": "yes", "to": "found" },
    { "from": "online", "output": "no", "to": "nextCb" },
    { "from": "found", "output": "next", "to": "end" },
    { "from": "nextCb", "output": "next", "to": "lastCb" },
    { "from": "lastCb", "output": "yes", "to": "allVisited" },
    { "from": "lastCb", "output": "no", "to": "pause" },
    { "from": "allVisited", "output": "next", "to": "end" },
    { "from": "pause", "output": "next", "to": "switch" },

    { "from": "kicked", "output": "next", "to": "retryPause" },
    { "from": "retryPause", "output": "next", "to": "switch" },
    { "from": "keyW", "output": "next", "to": "end" },
    { "from": "keyA", "output": "next", "to": "end" },
    { "from": "keyS", "output": "next", "to": "end" },
    { "from": "keyD", "output": "next", "to": "end" }
  ]
}
